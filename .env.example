# Copy to .env and adjust. Defaults run fully offline against the bundled mock IdP.

# Public origin the gateway is reachable at (used to build redirect_uri, cookies).
PUBLIC_BASE_URL=http://localhost:8000

# Secret used to sign session/flow cookies. MUST be changed for any real use.
SESSION_SECRET=change-me-to-a-long-random-value

# --- Identity provider -------------------------------------------------------
# Leave USE_MOCK_IDP=true for the bundled provider. Set false and fill the rest
# to point at a real OpenID Connect IdP.
USE_MOCK_IDP=true

# Discovery document URL. When USE_MOCK_IDP=true this defaults to the bundled
# provider at ${PUBLIC_BASE_URL}/mock-idp/.well-known/openid-configuration.
# For a real IdP, e.g.:
#   OIDC_DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration
#   OIDC_DISCOVERY_URL=https://<tenant>.auth0.com/.well-known/openid-configuration
# OIDC_DISCOVERY_URL=

OIDC_CLIENT_ID=mock-client
OIDC_CLIENT_SECRET=mock-secret
OIDC_SCOPES=openid profile email

# --- Cookies / sessions ------------------------------------------------------
SESSION_COOKIE_NAME=ssogw_session
FLOW_COOKIE_NAME=ssogw_flow
SESSION_TTL_SECONDS=3600
FLOW_TTL_SECONDS=600
